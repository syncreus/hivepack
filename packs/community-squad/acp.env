# buzz-acp harness environment for this pack's agents.
# Desktop: add these in Agents -> <agent> -> Environment after import.
# Headless: `set -a; source acp.env; set +a` before launching buzz-acp.
#
# Default (rules): see all chat traffic; replies stay mention/keyword-gated.
BUZZ_ACP_SUBSCRIBE=all
BUZZ_ACP_KINDS=9
#
# GREETER OVERRIDE — set these on the greeter agent INSTEAD of the defaults:
#   BUZZ_ACP_SUBSCRIBE=all
#   BUZZ_ACP_KINDS=40099
# Kind 40099 is the channel-join event. The greeter wakes only when someone
# joins, so chat messages can never spam it into replying.
